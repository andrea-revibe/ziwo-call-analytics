# Ziwo API (get credentials from your Ziwo account admin)
ZIWO_BASE_URL=https://revibe-api.aswat.co
ZIWO_USERNAME=
ZIWO_PASSWORD=

# Day to process. Single day per run. Format: YYYY-MM-DD.
ZIWO_TARGET_DATE=

# Gemini — used for both transcription and feature extraction.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
